{
  "name": "super-eslint",
  "type": "module",
  "version": "1.7.0",
  "description": "Shared ESLint flat config for JavaScript, TypeScript and React projects",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "files": [
    "index.mjs"
  ],
  "sideEffects": false,
  "author": "Roman Kovalev",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kovalevroman7/super-eslint.git"
  },
  "homepage": "https://github.com/kovalevroman7/super-eslint#readme",
  "bugs": {
    "url": "https://github.com/kovalevroman7/super-eslint/issues"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "flat-config",
    "typescript",
    "react"
  ],
  "scripts": {
    "test": "node --test test/package.test.mjs && eslint test/fixtures/valid.ts --config index.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "yarn": ">=1.22.0 <1.23.0",
    "node": ">=20.19.1"
  },
  "volta": {
    "node": "20.19.1",
    "yarn": "1.22.22"
  },
  "dependencies": {
    "@eslint/js": "9.38.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^51.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^60.0.0",
    "globals": "^16.4.0",
    "typescript-eslint": "^8.46.1"
  },
  "peerDependencies": {
    "eslint": "^9.38.0",
    "typescript": ">=4.8.4 <6.0.0"
  },
  "devDependencies": {
    "eslint": "9.38.0",
    "typescript": "5.9.3"
  }
}
